TARK_CONFIGURATION_HASH=UNRELEASED-PHASE1
TARK_DATABASE_PATH=data/database/tark.db
# Bounded, operator-started observation recordings. They contain no browser
# location and never send replay data to ESP32 or motors.
TARK_RECORDING_MAX_RECORDS=10000
# Documented LD2450 target-report decoder exists. A configured real_radar
# path can capture/decode reports; purchased-device identity/format still require
# separate physical verification. Keep the path blank for software-only work.
TARK_RADAR_PORT=
TARK_RADAR_BAUD=256000
TARK_RADAR_RECONNECT_INTERVAL_S=0.5
# ESP32 transport remains dormant until exact board identity and serial settings
# are reviewed. A configured value alone does not enable traction.
TARK_ESP32_DEVICE_PATH=
TARK_ESP32_BAUD=
TARK_ESP32_SERIAL_TIMEOUT_S=0.5
VITE_MAPTILER_STYLE_URL=
VITE_MAPTILER_PUBLIC_KEY=
# Map style priority: VITE_MAP_STYLE_URL, legacy MapTiler style, then OpenFreeMap Liberty.
# Optional display-only center: longitude,latitude. Leave blank for India overview.
VITE_MAP_STYLE_URL=
TARK_DEFAULT_MAP_CENTER=
TARK_DEFAULT_MAP_ZOOM=4.2
# Development-only HMI webcam preview. Default false; never vehicle camera.
TARK_ENABLE_BROWSER_CAMERA=false
# Pi/UVC camera is dormant until a selected device is physically identified.
TARK_CAMERA_DEVICE_PATH=
TARK_CAMERA_WIDTH=1280
TARK_CAMERA_HEIGHT=720
TARK_CAMERA_FPS=30
TARK_CAMERA_STALE_MS=3000
TARK_CAMERA_STREAM_FPS=10
TARK_CAMERA_JPEG_QUALITY=80
TARK_CAMERA_FAILURE_THRESHOLD=5
TARK_CAMERA_RECONNECT_INTERVAL_S=1
# BNO055 and MLX90640 remain dormant until physical I2C identity is verified.
TARK_IMU_I2C_BUS=1
TARK_IMU_I2C_ADDRESS=
TARK_IMU_SAMPLE_HZ=20
TARK_IMU_STALE_MS=1500
TARK_IMU_RECONNECT_INTERVAL_S=0.5
TARK_THERMAL_I2C_BUS=1
TARK_THERMAL_I2C_ADDRESS=
TARK_THERMAL_SAMPLE_HZ=8
TARK_THERMAL_STALE_MS=2000
TARK_THERMAL_RECONNECT_INTERVAL_S=0.5
# Optional server-side providers. Keep blank unless the operator has approved
# the provider and its privacy/rate-limit terms. No key is placed in the UI.
TARK_REVERSE_GEOCODER_URL=
TARK_ROUTE_PROVIDER_URL=
# LC29H(AA) hardware integration remains disabled until the selected USB device
# is physically identified and verified. Blank path means NO_RECEIVER.
TARK_GNSS_DEVICE_PATH=
TARK_GNSS_BAUD=115200
TARK_GNSS_SERIAL_TIMEOUT_S=0.5
TARK_GNSS_RECONNECT_INTERVAL_S=0.5
TARK_GNSS_RAW_LOG_ENABLED=false
TARK_GNSS_RAW_LOG_PATH=
TARK_GNSS_MAX_LINE_BYTES=1024
TARK_GNSS_FRESHNESS_MS=3000
TARK_GNSS_MAX_SPEED_MPS=55
TARK_GNSS_MAX_JUMP_M=150
TARK_GNSS_MIN_SATELLITES=4
TARK_GNSS_MAX_ACCURACY_M=100
TARK_GNSS_BREADCRUMB_LIMIT=300
TARK_REVERSE_GEOCODER_TIMEOUT_S=4
TARK_REVERSE_GEOCODER_REFRESH_S=60
TARK_ENV=development
TARK_AUTH_MODE=public_demo
TARK_ACCESS_TOKEN=
TARK_CORS_ORIGINS=
# PORT is provided by hosting platforms. Local Windows startup intentionally uses 8000.
PORT=
