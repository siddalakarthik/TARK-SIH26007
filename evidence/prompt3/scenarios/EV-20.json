      "args": {
        "pi_ns": 0,
        "receiver_ns": 0,
        "tick": true
      },
      "expect": {
        "communication": "ONLINE",
        "freshness": "FRESH",
        "state": "NORMAL"
      }
    },
    {
      "action": "STOP_RECORDING",
      "args": {},
      "expect": {
        "state": "NORMAL"
      }
    },
    {
      "action": "VERIFY_REPLAY",
      "args": {},
      "expect": {
        "replay": "MATCH",
        "state": "NORMAL"
      }
